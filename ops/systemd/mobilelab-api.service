[Unit]
Description=Mobile Lab Station local API
Documentation=file://__REPO_ROOT__/services/README.md
After=network-online.target postgresql.service mosquitto.service
Wants=postgresql.service mosquitto.service

[Service]
Type=simple
User=mobilelab
Group=mobilelab
WorkingDirectory=__REPO_ROOT__/services
EnvironmentFile=__REPO_ROOT__/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO_ROOT__/.venv/bin/python -m mobilelab.api
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mobilelab-api

# NoNewPrivileges is deliberately NOT set here.
#
# The power control runs "sudo -n /usr/bin/systemctl poweroff". sudo is setuid,
# and NoNewPrivileges forbids setuid by design, so sudo refuses before it ever
# reads the policy. The flag was set here, the API returned 200 OK, the screen
# said "Done", and the station stayed on. The button lied.
#
# The grant is still narrow. /etc/sudoers.d/mobilelab-power allows this user two
# exact commands, poweroff and reboot, and nothing else. Every other sandbox
# setting below stays on and was measured to work with sudo.
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target
